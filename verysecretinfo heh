local function safeTeleport(posOrCFrame)
	local c = LocalPlayer.Character
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	local hrp = getHRP(c)
	if not c or not hrp then return false end
	local targetCF = typeof(posOrCFrame) == "CFrame" and posOrCFrame or CFrame.new(posOrCFrame + Vector3.new(0, 3.5, 0))
	if hum then
		hum.Sit = false
		if hum:GetState() == Enum.HumanoidStateType.Physics then
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	c:PivotTo(targetCF)
	return true
end
local function getNearestTarget(maxDist)
	local myHrp = getHRP()
	if not myHrp then return nil, math.huge end
	local cam = workspace.CurrentCamera
	local mousePos = UserInputService:GetMouseLocation()
	local range = maxDist or state.spamRange
	local bestCursor, bestCursorScore = nil, math.huge
	local bestDistChar, bestDist = nil, range
	for _, c in ipairs(workspace:GetChildren()) do
		if c:IsA("Model") and c ~= LocalPlayer.Character then
			local hum = c:FindFirstChildOfClass("Humanoid")
			local hrp = getHRP(c)
			if hum and hum.Health > 0 and hrp and not c:GetAttribute("SpawnProtected") and not c:GetAttribute("Indespectus") then
				local targetable = true
				if TargetAssistMod and type(TargetAssistMod.IsTargetable) == "function" then
					local okT, resT = pcall(TargetAssistMod.IsTargetable, c)
					if okT and resT == false then targetable = false end
				end
				local plr = Players:GetPlayerFromCharacter(c) or Players:FindFirstChild(c.Name)
				if targetable and not (plr and state.excludeFriends and isFriend(plr)) then
					local d = (hrp.Position - myHrp.Position).Magnitude
					if d <= range then
						if d < bestDist then
							bestDist = d
							bestDistChar = c
						end
						if cam then
							local sp, onScr = cam:WorldToViewportPoint(hrp.Position)
							if onScr then
								local mDist = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
								if mDist <= 180 and mDist < bestCursorScore then
									bestCursorScore = mDist
									bestCursor = c
								end
							end
						end
					end
				end
			end
		end
	end
	local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	if isMobile then
		return bestDistChar or bestCursor, bestDist
	end
	return bestCursor or bestDistChar, bestDist
end
