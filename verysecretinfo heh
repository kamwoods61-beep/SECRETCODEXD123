	KW.computeM1AimTarget = function(target, myHrp, cam)
		cam = cam or workspace.CurrentCamera
		if not cam then return nil end
		local myChar = LocalPlayer.Character
		myHrp = myHrp or (myChar and myChar:FindFirstChild("HumanoidRootPart"))
		if not myHrp then return nil end
		local maxDist = (state.customRangeEnabled and (tonumber(state.customRangeDistance) or 0) > 0)
			and tonumber(state.customRangeDistance)
			or 1200
		local function isValidChar(c, ignoreRange)
			if not c or c == myChar or not c.Parent then return false end
			if c:GetAttribute("NoClickTarget") or c:GetAttribute("FakeDead") or c:GetAttribute("EmmaAstralBody") or c:GetAttribute("Inmortal") then
				return false
			end
			local p = Players:GetPlayerFromCharacter(c)
			if p == LocalPlayer then return false end
			if p and state.excludeFriends and isFriend and isFriend(p) then return false end
			local h = c:FindFirstChildOfClass("Humanoid")
			local r = c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart
			if not h or h.Health <= 0 or not r then return false end
			if not ignoreRange and (r.Position - myHrp.Position).Magnitude > maxDist then return false end
			local sp = cam:WorldToScreenPoint(r.Position)
			return sp.Z > 0.1
		end
		local mVec = (KW.getMouseVec and KW.getMouseVec()) or UserInputService:GetMouseLocation()
		local candSet = {}
		local validList = {}
		for _, p in ipairs(Players:GetPlayers()) do
			local c = p ~= LocalPlayer and p.Character
			if c and isValidChar(c, true) then
				candSet[c] = true
				table.insert(validList, c)
			end
		end
		-- Step 1: Direct cursor hover ALWAYS wins (even over closer/farther range targets), never hijack onto another player
		local hoveredChar, hoveredPos = nil, nil
		if KW.raycastModelUnderMouse then
			hoveredChar, hoveredPos = KW.raycastModelUnderMouse(cam, mVec, myChar, candSet)
		end
		if hoveredChar then
			target = hoveredChar
		else
			-- Step 2: Near-cursor assist cone only (purely closest pixel to cursor within 95px & maxDist; ignore worldDist bias)
			if target and target:IsA("BasePart") then
				target = target:FindFirstAncestorOfClass("Model")
			elseif target and target:IsA("Player") then
				target = target.Character
			end
			local bestChar, bestPx = nil, 650
			for _, c in ipairs(validList) do
				local r = c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart
				if r and (r.Position - myHrp.Position).Magnitude <= maxDist then
					local pxDist = KW.getModelCursorDist and KW.getModelCursorDist(cam, mVec, c) or math.huge
					if pxDist < bestPx then
						bestPx = pxDist
						bestChar = c
					end
				end
			end
			target = bestChar
		end
		if not target then return nil end
		if hoveredChar == target and hoveredPos then
			local sp = cam:WorldToScreenPoint(hoveredPos)
			if sp.Z > 0.1 then
				return hoveredPos, Vector2.new(sp.X, sp.Y)
			end
		end
		local rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Exclude
		local ignore = { myChar }
		local vfx = workspace:FindFirstChild("VFX")
		local proj = workspace:FindFirstChild("Projectiles")
		if vfx then table.insert(ignore, vfx) end
		if proj then table.insert(ignore, proj) end
		rp.FilterDescendantsInstances = ignore
		local candidates = {
			target:FindFirstChild("UpperTorso"),
			target:FindFirstChild("Torso"),
			target:FindFirstChild("HumanoidRootPart"),
			target:FindFirstChild("Head"),
		}
		local chosenPos = nil
		local fallbackPos = nil
		for _, part in ipairs(candidates) do
			if part and part:IsA("BasePart") then
				if not fallbackPos then fallbackPos = part.Position end
				local origin = cam.CFrame.Position
				local dir = part.Position - origin
				if dir.Magnitude > 0.1 then
					local res = workspace:Raycast(origin, dir, rp)
					if not res or res.Instance:IsDescendantOf(target) or (res.Position - part.Position).Magnitude < 3.5 then
						chosenPos = (res and res.Instance:IsDescendantOf(target)) and res.Position or part.Position
						break
					end
				end
			end
		end
		local aimPos = chosenPos or fallbackPos
		if not aimPos then return nil end
		local sp = cam:WorldToScreenPoint(aimPos)
		if sp.Z <= 0.1 then return nil end
		return aimPos, Vector2.new(sp.X, sp.Y)
	end
