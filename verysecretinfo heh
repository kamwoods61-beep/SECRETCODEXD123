		local chip = kwNew("TextButton", { Size = UDim2.fromOffset(82, 20), Position = UDim2.new(1, -90, 0.5, -10), BackgroundColor3 = KW_T.Control, Font = Enum.Font.Code, TextSize = 10.5, TextColor3 = KW_T.Cyan, Text = curKey.Name }, row)
		kwRound(chip, 5)
		local listening = false
		chip.MouseButton1Click:Connect(function() listening = true; isListeningKeybind = true; chip.Text = "..." end)
		trackConn(UserInputService.InputBegan:Connect(function(inp)
			if listening and inp.UserInputType == Enum.UserInputType.Keyboard then
				listening = false; curKey = inp.KeyCode; chip.Text = curKey.Name
				task.defer(function() isListeningKeybind = false end)
				if cb then pcall(cb, curKey) end
			end
		end))
