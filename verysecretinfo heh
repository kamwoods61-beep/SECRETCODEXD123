local function shouldRecolor(inst)
	if not state.powerRecolor then return false end
	local char = LocalPlayer.Character
	if not char then return false end
	-- Visual effect types
	local isVisual = inst:IsA("ParticleEmitter") or inst:IsA("Beam") or inst:IsA("Trail")
		or inst:IsA("PointLight") or inst:IsA("SpotLight") or inst:IsA("SurfaceLight")
		or inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Sparkles") or inst:IsA("Highlight")
		or inst:IsA("BasePart")
	if not isVisual then return false end
	-- Exclude all character limbs, nested body/hair/clothing MeshParts, and accessories
	if inst:IsA("BasePart") then
		local p = inst.Parent
		if p and (p:FindFirstChildOfClass("Humanoid") or p:IsA("Accessory") or p.Name == "Accessories") then
			return false
		end
		if inst:FindFirstAncestorOfClass("Accessory") then return false end
		local ancModel = inst:FindFirstAncestorOfClass("Model")
		if ancModel and ancModel:FindFirstChildOfClass("Humanoid") then
			return false
		end
		-- Only spell VFX parts
		local n = inst.Name:lower()
		local isSpellPart = inst.Material == Enum.Material.Neon
			or n:find("beam") or n:find("spell") or n:find("blast") or n:find("orb")
			or n:find("aura") or n:find("hitbox") or n:find("shield") or n:find("projectile")
			or n:find("vfx") or n:find("effect") or n:find("star") or n:find("shockwave") or n:find("ripple")
		if not isSpellPart and not inst:IsA("MeshPart") then
			return false
		end
	end
	-- 1. Descendant of LocalPlayer's Character (only VFX emitters/beams/trails/lights, never character parts/clothes/eyes)
	if inst:IsDescendantOf(char) then
		if inst:IsA("BasePart") or inst:IsA("Highlight") or inst:IsA("Decal") then
			return false
		end
		if inst:GetFullName():find("%.Eye%.") then
			return false
		end
		return true
	end
	-- 2. LocalPlayer's Projectiles (ProjectileContainer / LocalProjectileContainer)
	for _, pcName in ipairs({ "ProjectileContainer", "LocalProjectileContainer" }) do
		local pc = workspace:FindFirstChild(pcName)
		if pc and inst:IsDescendantOf(pc) then
			local top = inst
			while top.Parent and top.Parent ~= pc and top.Parent ~= workspace do
				top = top.Parent
			end
			if top:GetAttribute("LocalShot") or (os.clock() - (KW.lastOwnShotTime or 0)) < 2.0 or (os.clock() - (KW.lastOwnAbilityCastAt or 0)) < 2.0 or state.powerRecolorAllWorkspace then
				return true
			end
		end
	end
	-- 3. Visual effects in VFX / Projectiles / Debris / Terrain
	local ownRecent = (os.clock() - (KW.lastOwnAbilityCastAt or 0)) < 2.5 or (os.clock() - (KW.lastOwnShotTime or 0)) < 2.5 or state.powerRecolorAllWorkspace
	for _, fName in ipairs({ "VFX", "Projectiles", "Debris" }) do
		local vf = workspace:FindFirstChild(fName)
		if vf and inst:IsDescendantOf(vf) then
			local top = inst
			while top.Parent and top.Parent ~= vf and top.Parent ~= workspace do
				top = top.Parent
			end
			if ownRecent or top:GetAttribute("Owner") == LocalPlayer.Name or top:GetAttribute("Creator") == LocalPlayer.Name or top.Name:find(LocalPlayer.Name, 1, true) then
				return true
			end
		end
	end
	if ownRecent and inst:IsDescendantOf(workspace.Terrain) then
		local p = inst.Parent
		if p and (p:IsA("Attachment") or p:IsA("Part") or p:IsA("Model")) then
			return true
		end
	end
	return false
end
