local function completeAllCharacterQuests()
	if not QuestRequestRemote then return 0 end
	local ok, qData = pcall(function() return QuestRequestRemote:InvokeServer("Get") end)
	if not ok or type(qData) ~= "table" then return 0 end
	local completedCount = 0
	if type(qData.Character) == "table" then
		for _, q in ipairs(qData.Character) do
			if type(q) == "table" and q.State ~= "claimed" then
				local qId = q.Id
				local goal = tonumber(q.Goal) or 5
				if q.State == "new" then
					pcall(function() QuestRequestRemote:InvokeServer("Accept", qId) end)
					task.wait(0.15)
				end
				if qId == "c_spellshrooms" or qId == "c_lostpages" or qId == "c_ingredients" then
					for idx = 1, goal do
						pcall(function() QuestRequestRemote:InvokeServer("Collect", qId, idx) end)
						task.wait(0.12)
					end
				end
				local tOk = pcall(function() QuestRequestRemote:InvokeServer("TurnIn", qId) end)
				if tOk then completedCount += 1 end
				task.wait(0.15)
			end
		end
	end
	if type(qData.Daily) == "table" then
		for _, q in ipairs(qData.Daily) do
			if type(q) == "table" and not q.Claimed and (q.Progress or 0) < (q.Goal or 1) then
				if q.Id == "d_healpool" then
					local poolPos = getHealingPoolPos()
					if poolPos then safeTeleport(poolPos) task.wait(1.0) end
				elseif q.Id == "d_cave" then
					local locs = workspace:FindFirstChild("Locations")
					local wf = locs and locs:FindFirstChild("WaterfallProx")
					local prompt = wf and wf:FindFirstChildOfClass("ProximityPrompt")
					if wf then
						safeTeleport(wf.Position)
						task.wait(0.2)
						if prompt and type(fireproximityprompt) == "function" then
							pcall(fireproximityprompt, prompt)
						end
					end
				end
			end
		end
	end
	return completedCount
end
local function claimAllQuests()
	if not QuestRequestRemote then return 0 end
	local ok, qData = pcall(function() return QuestRequestRemote:InvokeServer("Get") end)
	if not ok or type(qData) ~= "table" then return 0 end
	local claimed = 0
	for _, bucketName in ipairs({ "Daily", "Weekly", "Character" }) do
		local list = qData[bucketName]
		if type(list) == "table" then
			for _, q in ipairs(list) do
				if type(q) == "table" and not q.Claimed and q.State ~= "claimed" and (q.Progress or 0) >= (q.Goal or 1) then
					local cOk = pcall(function() QuestRequestRemote:InvokeServer("Claim", q.Id) end)
					if cOk then claimed += 1 end
					task.wait(0.15)
				end
			end
		end
	end
	return claimed
end
