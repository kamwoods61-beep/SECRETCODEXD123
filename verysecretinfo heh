-- No Cooldown hooks for Targeting & OmniClient (supports frozen module tables)
local hookedModFns = {}
local function hookModFn(mod, key, makeHook)
	if type(mod) ~= "table" then return end
	local orig = mod[key]
	if type(orig) ~= "function" then return end
	if type(table.isfrozen) == "function" and table.isfrozen(mod) then
		if type(hookfunction) == "function" then
			pcall(function()
				local origCopy
				origCopy = hookfunction(orig, function(...)
					return makeHook(origCopy)(...)
				end)
				table.insert(hookedModFns, { kind = "hook", target = orig, orig = origCopy })
			end)
		end
	else
		pcall(function()
			mod[key] = makeHook(orig)
			table.insert(hookedModFns, { kind = "table", mod = mod, key = key, orig = orig })
		end)
	end
end
