			KW.hookedOriginals.emitTouchFn = rawEmitTouch
			local wrappedEmitTouch = function(self, ...)
				pcall(function() self.WorldClickBlockUntil = 0 end)
				return rawEmitTouch(self, ...)
			end
			KW.kwWrappedFuncs[wrappedEmitTouch] = true
			InputController.EmitTouchTap = wrappedEmitTouch
		end
		if type(InputController.TouchingInWorld) == "function" and not KW.kwWrappedFuncs[InputController.TouchingInWorld] then
			local rawTouching = InputController.TouchingInWorld
			KW.hookedOriginals.touchingInWorldFn = rawTouching
