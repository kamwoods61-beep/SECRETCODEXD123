function KW.inspectTargetingListeners(forKey)
	if not isNewFender or not InputController or not AbilityController then
		return nil
	end
	local cur = AbilityController.CurrentAbility
	local conc = AbilityController.Concurrent
	local hasActiveAbility = (cur ~= nil and cur ~= "Fly")
		or (conc ~= nil and conc ~= "Fly")
		or AbilityController.WheelArmedBind ~= nil
		or AbilityController.WheelAimingBind ~= nil
	if not hasActiveAbility then return nil end
	if forKey and cur ~= forKey and conc ~= forKey then return nil end
	local t2 = KW.getWhenMouse1DownTable()
	local ml = InputController.MouseDownListeners
	local wl = InputController.MouseDownInWorldListeners
	local tl = InputController.TouchTapInWorldListeners
	local abilityWrappers = {}
	local abilityWorldFns = {}
	local abilityTouchFns = {}
	local checkedFns = {}
	-- 1. Inspect MouseDownListeners
	if type(ml) == "table" then
		for i = 1, #ml do
			local w = ml[i]
			if type(w) == "function" and not checkedFns[w] then
				checkedFns[w] = true
				if not isNonAbilityListener(w) then
					local meta = t2 and t2[w]
					local inner = KW.unwrapMouse1Inner(w)
					if type(meta) == "table" then
						if meta.FromAbility == true then
							table.insert(abilityWrappers, { wrapper = w, inner = inner })
						else
							KW.knownNonAbilityFns[w] = true
							if inner then KW.knownNonAbilityFns[inner] = true end
						end
					else
						table.insert(abilityWorldFns, w)
					end
				end
			end
		end
	end
	-- 2. Inspect MouseDownInWorldListeners
	if type(wl) == "table" then
		for i = 1, #wl do
			local fn = wl[i]
			if type(fn) == "function" and not checkedFns[fn] then
				checkedFns[fn] = true
				if not isNonAbilityListener(fn) then
					table.insert(abilityWorldFns, fn)
				end
			end
		end
	end
	-- 3. Inspect TouchTapInWorldListeners
	if type(tl) == "table" then
		for i = 1, #tl do
			local fn = tl[i]
			if type(fn) == "function" and not checkedFns[fn] then
				checkedFns[fn] = true
				if not isNonAbilityListener(fn) then
					table.insert(abilityTouchFns, fn)
				end
			end
		end
	end
	if #abilityWrappers == 0 and #abilityWorldFns == 0 and #abilityTouchFns == 0 then
		return nil
	end
	return {
		wrappers = abilityWrappers,
		world = abilityWorldFns,
		touch = abilityTouchFns,
	}
end
