local friendCache = {}
local function isFriend(plr)
	if not plr or plr == LocalPlayer then return false end
	if friendCache[plr.UserId] ~= nil then return friendCache[plr.UserId] end
	local ok, res = pcall(function() return LocalPlayer:IsFriendsWith(plr.UserId) end)
	friendCache[plr.UserId] = ok and res or false
	return friendCache[plr.UserId]
end
local function getHRP(char)
	char = char or LocalPlayer.Character
	return char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
end
local function tpTo(pos)
	local c = LocalPlayer.Character
	local hrp = getHRP(c)
	if hrp and c then
		manualTpTime = os.clock()
		lastSafeTickPos = pos
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		c:PivotTo(CFrame.new(pos))
	end
end
local function ensureLobbyBeforeSpawn()
	local c = LocalPlayer.Character
	if c and c:FindFirstChild("PowerClient") then
		local rp = ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("RespawnPlayer")
		if rp then
			pcall(function() rp:FireServer() end)
			local t0 = os.clock()
			while (os.clock() - t0) < 2.5 do
				local cur = LocalPlayer.Character
				if not cur or not cur:FindFirstChild("PowerClient") then break end
				task.wait(0.08)
			end
			task.wait(0.15)
		end
	end
end
local function spawnCustom(species, alignment)
	manualTpTime = os.clock()
	task.spawn(function()
		ensureLobbyBeforeSpawn()
		local mg = PlayerGui:FindFirstChild("MainGui")
		if mg and mg:FindFirstChild("MainFrame") then mg.MainFrame.Visible = false end
		if mg and mg:FindFirstChild("CharacInfo") then mg.CharacInfo.Visible = true end
		local lookRaw = LocalPlayer:GetAttribute("CRLookLocal") or LocalPlayer:GetAttribute("CRLook")
		local okJ, look = pcall(function() return lookRaw and HttpService:JSONDecode(lookRaw) end)
		local gender = (okJ and type(look) == "table" and look.Gender == "Female") and "Feminine" or "Masculine"
		local anim = (okJ and type(look) == "table" and look.Anim) or "Arms Behind"
		local ev = ReplicatedStorage:FindFirstChild("Events")
			and ReplicatedStorage.Events:FindFirstChild("Misc")
			and ReplicatedStorage.Events.Misc:FindFirstChild("CustomChar")
		if ev then
			pcall(function()
				ev:FireServer("TVRLook", "TVRLook", gender, "TVRLook", species or "Demon", alignment or "Evil", anim, "Low", "None")
			end)
		end
	end)
end
local function spawnCharacter(charName)
	if not charName or charName == "" then return end
	if charName == "CustomCharMale" or charName == "CustomCharFemale" then
		spawnCustom("Demon", "Evil")
		return
	end
	manualTpTime = os.clock()
	task.spawn(function()
		ensureLobbyBeforeSpawn()
		local chg = ReplicatedStorage:FindFirstChild("Change")
		if chg and chg:IsA("RemoteEvent") then
			pcall(function() chg:FireServer(charName) end)
		end
	end)
end
local lastSpawnTry = 0
local function tryAutoSpawn()
	if (os.clock() - lastSpawnTry) < 2.8 then return end
	lastSpawnTry = os.clock()
	if state.autoSpawnMode == "CustomDemon" then
		spawnCustom("Demon", "Evil")
	elseif state.autoSpawnMode == "CustomWitch" then
		spawnCustom("Witch", "Good")
	elseif state.autoSpawnMode == "SelectedChar" then
		spawnCharacter(state.selectedChar)
	else
