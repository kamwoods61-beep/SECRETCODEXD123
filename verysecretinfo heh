local disabledDumpConns = {}
local function applyAutoclickerBypass(enabled)
	if enabled then
		if type(getconnections) == "function" then
			pcall(function()
				for _, cn in ipairs(getconnections(UserInputService.InputBegan)) do
					local f = cn.Function
					if f then
						local env = getfenv(f)
						local scr = env and env.script
						if scr and scr.Name == "Dump" and cn.Enabled then
							cn:Disable()
							table.insert(disabledDumpConns, cn)
						end
					end
				end
			end)
		end
	else
		for _, cn in ipairs(disabledDumpConns) do
			pcall(function() cn:Enable() end)
		end
		table.clear(disabledDumpConns)
	end
end
