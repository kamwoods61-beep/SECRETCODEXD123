		local function apply(v)
			val = v and true or false
			kwTween(track, { BackgroundColor3 = val and KW_T.Accent or KW_T.Control }, 0.14)
			kwTween(knob, { Position = val and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2), BackgroundColor3 = val and Color3.new(1, 1, 1) or KW_T.SubText }, 0.14)
