	KW.handleAntiSummonStep = function(hrp, hum)
		local now = os.clock()
		if KW.inAntiSummonSnap or not hrp or not hum or hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then
			return
		end
		if AbilityController and (AbilityController.CurrentAbility ~= nil or AbilityController.Concurrent ~= nil) then
			KW.lastOwnAbilityAt = now
		end
		if now < (KW.allowClientTpUntil or 0)
			or (AbilityController and AbilityController.Flying == true)
			or KW.isVictimTrappedInPendant()
			or (now - (KW.ek5LastEscapeAt or 0)) < 4.0
			or (now - (KW.lastCharAddedAt or 0)) < 4.5
			or hum.SeatPart ~= nil then
			KW.antiSummonLastSafeCF = hrp.CFrame
			KW.summonBlockPullbackUntil = 0
			KW.summonBlockedDestPos = nil
			return
		end
		if now < (KW.summonBlockPullbackUntil or 0) and KW.summonBlockedDestPos then
			for _, bm in ipairs(hrp:GetChildren()) do
				if (bm:IsA("BodyVelocity") or bm:IsA("BodyPosition") or bm:IsA("LinearVelocity") or bm:IsA("AlignPosition"))
					and not (AbilityController and (AbilityController.CurrentAbility or AbilityController.Concurrent)) then
					pcall(function() bm:Destroy() end)
				end
			end
			if (hrp.Position - KW.summonBlockedDestPos).Magnitude < 32 and KW.antiSummonLastSafeCF then
				KW.inAntiSummonSnap = true
				hrp.CFrame = KW.antiSummonLastSafeCF
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
				KW.inAntiSummonSnap = false
				return
			end
		end
		local curCF = hrp.CFrame
		local safeCF = KW.antiSummonLastSafeCF
		if safeCF then
			local delta = (curCF.Position - safeCF.Position).Magnitude
			if delta > 35 then
				local atSummonSpot = KW.isNearActiveSummonSpot(curCF.Position, 36)
				local hasHostileSignal = (now < (KW.hostileSummonSignalUntil or 0))
					and ((now - (KW.lastOwnAbilityAt or 0)) > 1.2)
					and not LocalPlayer:GetAttribute("InWitchesQuest")
					and not KW.isNearSpawnPoint(curCF.Position)
				if atSummonSpot or hasHostileSignal then
					KW.summonBlockedDestPos = curCF.Position
					KW.summonBlockPullbackUntil = now + 0.45
					KW.inAntiSummonSnap = true
					hrp.CFrame = safeCF
					hrp.AssemblyLinearVelocity = Vector3.zero
					hrp.AssemblyAngularVelocity = Vector3.zero
					KW.inAntiSummonSnap = false
					task.defer(KW.clearSummonEffects)
					return
				end
			end
		end
		KW.antiSummonLastSafeCF = curCF
	end
