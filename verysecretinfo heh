		end
		apply(val)
		row.MouseButton1Click:Connect(function() apply(not val); if cb then pcall(cb, val) end end)
		return { UpdateState = function(_, v) apply(v) end }
	end
	function sec:Slider(title, minV, maxV, step, defV, cb)
		local cur = math.clamp(defV or minV, minV, maxV)
		local wrap = kwNew("Frame", { Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = KW_T.Control, BackgroundTransparency = 0.45, BorderSizePixel = 0 }, activeTarget)
