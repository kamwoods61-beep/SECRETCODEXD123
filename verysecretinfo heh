local fpsBoostOriginals = {}
local fpsBoostAddedConn = nil
local function applyFpsBooster(enable)
	state.fpsBooster = enable
	if fpsBoostAddedConn then
		pcall(function() fpsBoostAddedConn:Disconnect() end)
		fpsBoostAddedConn = nil
	end
	local lgt = game:GetService("Lighting")
	local mapFolder = workspace:FindFirstChild("Map")
	local function stripInstance(d)
		if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles") or d:IsA("Beam") then
			if d.Enabled then
				if fpsBoostOriginals[d] == nil then fpsBoostOriginals[d] = true end
				d.Enabled = false
			end
		elseif d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
			if d.Enabled then
				if fpsBoostOriginals[d] == nil then fpsBoostOriginals[d] = true end
				d.Enabled = false
			end
		elseif d:IsA("BasePart") then
			if d.CastShadow or d.Reflectance > 0 then
				if fpsBoostOriginals[d] == nil then fpsBoostOriginals[d] = { CastShadow = d.CastShadow, Reflectance = d.Reflectance } end
				d.CastShadow = false
				d.Reflectance = 0
			end
		end
	end
	pcall(function()
		if enable then
			fpsBoostOriginals.GlobalShadows = lgt.GlobalShadows
			fpsBoostOriginals.EnvSpecular = lgt.EnvironmentSpecularScale
			lgt.GlobalShadows = false
			lgt.EnvironmentSpecularScale = 0
			for _, eff in ipairs(lgt:GetChildren()) do
				if (eff:IsA("BlurEffect") or eff:IsA("DepthOfFieldEffect") or eff:IsA("SunRaysEffect") or eff:IsA("BloomEffect")) and eff.Enabled then
					fpsBoostOriginals[eff] = true
					eff.Enabled = false
				end
			end
			local ter = workspace:FindFirstChildOfClass("Terrain")
			if ter then
				fpsBoostOriginals.Decoration = ter.Decoration
				fpsBoostOriginals.WaterWaveSize = ter.WaterWaveSize
				fpsBoostOriginals.WaterWaveSpeed = ter.WaterWaveSpeed
				fpsBoostOriginals.WaterReflectance = ter.WaterReflectance
				ter.Decoration = false
				ter.WaterWaveSize = 0
				ter.WaterWaveSpeed = 0
				ter.WaterReflectance = 0
			end
			for _, d in ipairs(workspace:GetDescendants()) do
				stripInstance(d)
			end
			fpsBoostAddedConn = workspace.DescendantAdded:Connect(function(d)
				if state.fpsBooster then
					pcall(stripInstance, d)
				end
			end)
		else
			if fpsBoostOriginals.GlobalShadows ~= nil then lgt.GlobalShadows = fpsBoostOriginals.GlobalShadows end
			if fpsBoostOriginals.EnvSpecular ~= nil then lgt.EnvironmentSpecularScale = fpsBoostOriginals.EnvSpecular end
			local ter = workspace:FindFirstChildOfClass("Terrain")
			if ter then
