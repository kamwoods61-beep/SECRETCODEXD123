				if key == "ExtraKey5" or (btn and btn.Name == "ExtraKey5") then
					KW.ek5Role = "caster"
					KW.ek5CasterActiveUntil = os.clock() + 30.0
				end
				return rawKeyDown(btn, key, ...)
