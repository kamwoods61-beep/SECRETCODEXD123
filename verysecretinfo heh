function KW.disarmSummonInstance(d)
	if not d or not d.Parent then return end
	if LocalPlayer.Character and d:IsDescendantOf(LocalPlayer.Character) then return end
	local pgui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if pgui and d:IsDescendantOf(pgui) then
		if d.Name == "Red3" then pcall(function() d:Destroy() end) end
		return
	end
	local owner = d:GetAttribute("Owner") or d:GetAttribute("Caster")
	if owner == LocalPlayer.Name or d:GetAttribute("UserId") == LocalPlayer.UserId then return end
	local nl = d.Name:lower()
	local isSummonObj = nl == "summon" or nl == "summon2" or nl == "summonsalt" or nl == "summoncircle"
		or nl == "orbsummon" or nl:find("summoncircle", 1, true) or nl:find("summontrap", 1, true)
		or nl:find("orbsummon", 1, true)
	if not isSummonObj and d.Parent then
		local pnl = d.Parent.Name:lower()
		if pnl == "summon" or pnl == "summon2" or pnl == "summonsalt" or pnl == "summoncircle" or pnl:find("summontrap", 1, true) then
			isSummonObj = true
		end
	end
	if not isSummonObj then return end
	if (os.clock() - (KW.lastOwnSummonCastAt or 0)) < 3.0 and d:IsA("BasePart") then
		local c = LocalPlayer.Character
		local hrp = c and c:FindFirstChild("HumanoidRootPart")
		if hrp and (d.Position - hrp.Position).Magnitude < 14 and nl ~= "orbsummon" then
			return
		end
	end
	if d:IsA("TouchTransmitter") then
		pcall(function() d:Destroy() end)
	elseif d:IsA("BasePart") then
		d.CanTouch = false
		d.CanCollide = false
		d.CanQuery = false
		for _, sub in ipairs(d:GetDescendants()) do
			if sub:IsA("TouchTransmitter") then pcall(function() sub:Destroy() end) end
		end
		if nl == "orbsummon" then
			d.Transparency = 1
		end
	elseif d:IsA("Model") or d:IsA("Folder") then
		for _, sub in ipairs(d:GetDescendants()) do
			if sub:IsA("TouchTransmitter") then
				pcall(function() sub:Destroy() end)
			elseif sub:IsA("BasePart") then
				sub.CanTouch = false
				sub.CanCollide = false
				sub.CanQuery = false
			end
		end
	end
end
