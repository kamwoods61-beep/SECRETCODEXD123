	KW.vertexWindow = Window
	setWindowVisible = function(v) Window:SetState(v) end
	notify = function(title, message)
		Window:Notify({ Title = title or BRAND, Description = message or "", Duration = 3.2 })
	end
	local flagCounter = 0
	local function nextFlag(title)
		flagCounter += 1
		local clean = tostring(title or "opt"):gsub("[^%w]", "")
		return "KW_" .. clean .. "_" .. tostring(flagCounter)
	end
	local function section(parent, title)
		return parent:Header({ Text = tostring(title or "") })
	end
	local function toggle(parent, title, desc, default, callback)
		local flag = nextFlag(title)
		local tObj = parent:Toggle(flag, title, { Default = default and true or false }, function(v)
			pcall(callback, v)
		end)
		if default then
			pcall(function()
				if tObj.UpdateState then tObj:UpdateState(true) end
			end)
		end
		return {
			Row = tObj,
			Set = function(v)
				pcall(function() if tObj.UpdateState then tObj:UpdateState(v and true or false) end end)
			end,
		}
	end
	local function slider(parent, title, minV, maxV, step, default, formatter, callback)
		local flag = nextFlag(title)
		local sObj = parent:Slider(flag, title, minV, maxV, default or minV, "Round", function(v)
			local st = step or 1
			local snapped = math.floor((v / st) + 0.5) * st
			snapped = math.clamp(snapped, minV, maxV)
			pcall(callback, snapped)
		end)
		return sObj
	end
	local function button(parent, label, style, callback)
		local bObj
		bObj = parent:Button({
			Name = label,
			Callback = function()
				pcall(callback, bObj)
			end,
		})
		return bObj
	end
	local function dropdown(parent, title, options, current, callback)
		local opts = (type(options) == "table" and #options > 0) and options or { "None" }
		local defIdx = 1
		for i, opt in ipairs(opts) do
			if opt == current then defIdx = i break end
		end
		return parent:Dropdown({
			Name = title,
			Search = (#opts > 6),
			Multi = false,
			Required = true,
			Options = opts,
			Default = defIdx,
			Callback = function(v)
				pcall(callback, v)
			end,
		}, nextFlag(title))
	end
	local function choice(parent, title, options, current, callback)
		return dropdown(parent, title, options, current, callback)
	end
	local function statusCard(parent, names)
		local setters = {}
		for _, name in ipairs(names) do
			local lbl = parent:Label({ Text = name .. ": -" })
			setters[name] = function(t, color)
				pcall(function() lbl:UpdateName(name .. ": " .. tostring(t)) end)
			end
		end
		return setters
	end
	local function colorWheelPicker(parent, title, defaultColor, callback)
		local curCol = defaultColor or state.powerRecolorColor or Color3.fromRGB(0, 235, 117)
		local cp = parent:Colorpicker({
			Name = title or "Color Picker",
			Default = curCol,
			Callback = function(col)
				curCol = col
				if callback then
					local h, s, v = col:ToHSV()
					pcall(callback, col, h, s, v)
				end
			end,
		}, nextFlag(title or "ColorPicker"))
		local api = { Outer = cp }
		function api.SetColor(col, silent)
			curCol = col
			pcall(function() if cp.SetColor then cp:SetColor(col) end end)
			if not silent and callback then
				local h, s, v = col:ToHSV()
				pcall(callback, col, h, s, v)
			end
		end
		function api.GetColor() return curCol end
		return api
	end
