local realCooldownsTable = nil
local function findInternalCooldownsTable()
	if realCooldownsTable then return realCooldownsTable end
	if not AbilityController or not AbilityController.StartCooldown or not debug or not debug.getupvalues then
		return AbilityController and AbilityController.Cooldowns or nil
	end
	local okUp, directUps = pcall(debug.getupvalues, AbilityController.StartCooldown)
	if okUp and type(directUps) == "table" and type(directUps[4]) == "table" and directUps[4] ~= AbilityController then
		realCooldownsTable = directUps[4]
		return realCooldownsTable
	end
	local function scanFn(fn, depth)
		if depth > 3 or type(fn) ~= "function" then return nil end
		local ok, ups = pcall(debug.getupvalues, fn)
		if not ok or type(ups) ~= "table" then return nil end
		for _, val in pairs(ups) do
			if type(val) == "table" and (val.Fly ~= nil or val.Q ~= nil or val.E ~= nil or val.R ~= nil or val.F ~= nil or val.Z ~= nil or val.X ~= nil or val.C ~= nil or val.ExtraKey1 ~= nil or val.ExtraKey2 ~= nil or val.ExtraKey3 ~= nil or val.ExtraKey4 ~= nil) then
				return val
			end
			if type(val) == "function" then
				local found = scanFn(val, depth + 1)
				if found then return found end
			end
		end
		return nil
	end
	realCooldownsTable = scanFn(AbilityController.StartCooldown, 1)
	return realCooldownsTable or (AbilityController and AbilityController.Cooldowns)
end
