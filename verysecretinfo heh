	if rawGetTargetingCd then
		local ok, v = pcall(rawGetTargetingCd, abName)
		if ok and type(v) == "number" and v > cd then cd = v end
	end
	if rawGetOmniCd and isOmniAbility(abName) then
		local ok, v = pcall(rawGetOmniCd, abName)
