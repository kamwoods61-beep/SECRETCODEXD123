				end
				return rawFire(self, name, ...)
			end
			KW.kwWrappedFuncs[wrappedFire] = true
			req.Fire = wrappedFire
		end
	end
	-- ============================================================================
	-- M1 & TOUCH REPLICATION SAFEGUARD (Clear click block without double-firing)
	-- ============================================================================
	if InputController then
		if type(InputController.EmitMouse1Down) == "function" and not KW.kwWrappedFuncs[InputController.EmitMouse1Down] then
			local rawEmitM1 = InputController.EmitMouse1Down
			KW.hookedOriginals.emitM1Fn = rawEmitM1
			local wrappedEmitM1 = function(self, ...)
				pcall(function() self.WorldClickBlockUntil = 0 end)
				return rawEmitM1(self, ...)
			end
			KW.kwWrappedFuncs[wrappedEmitM1] = true
			InputController.EmitMouse1Down = wrappedEmitM1
		end
		if type(InputController.EmitTouchTap) == "function" and not KW.kwWrappedFuncs[InputController.EmitTouchTap] then
