local function executeSingleSpamTick(key)
	if isHoldingTelekinesis() or isShieldActive() or pauseReason() then
		return
	end
	if not key or key == "Fly" or (isNewFender and key == "Q") then return end
	if key == "F" then
		local ch = LocalPlayer.Character
		if (AbilityController and AbilityController.Flying == true)
			or (ch and ch:GetAttribute("NameTag") == "RioVidal") then
			return
		end
	end
	if state.spamKeys[key] == false then return end
	if isNewFender then
		if not AbilityController then return end
		-- 1. Auto-Confirm Targeting Input (instant click like Netherware: aims & casts without spamming key)
		if hasActiveTargetingListener() then
			local confirmBurst = state.maxSpeed and 20 or 1
			for _ = 1, confirmBurst do
				if not confirmActiveAbilityListener() then break end
			end
			return
		end
		local now = os.clock()
		if not KW.dispatchedHeldKeys then KW.dispatchedHeldKeys = {} end
		-- Clean up released keys so subsequent taps aren't stuck
		if not heldKeys[key] and not KW.heldHudButtons[key] then
			KW.dispatchedHeldKeys[key] = nil
		end
		local dispatchedAt = KW.dispatchedHeldKeys[key]
		-- 2. Respect Hold Stance / Channeling & Active Ability
		-- Do NOT re-invoke _keyDown / _pressExtra while key is held!
		-- Re-firing keydown while holding toggles off / cancels abilities!
		if dispatchedAt then
			if (now - dispatchedAt) > 0.8 or (AbilityController.CurrentAbility ~= key) then
				KW.dispatchedHeldKeys[key] = nil
				dispatchedAt = nil
			else
				local isHoldingStance = (AbilityController.Holding == true)
				local char = LocalPlayer.Character
				local isCharHolding = char and (char:GetAttribute("Holding") == true or char:GetAttribute("Casting") == true)
				local cur = AbilityController.CurrentAbility
				local isCurActive = (cur == key)
				if isHoldingStance or isCharHolding or isCurActive then
					-- Ability is currently held / channeled: let it run smoothly!
					return
				end
				-- Minimum cast execution window before any re-cast
				local minCastWindow = state.maxSpeed and 0 or 0.015
				if (now - dispatchedAt) < minCastWindow then
					return
				end
				-- If on cooldown, do NOT re-dispatch until cooldown expires
				if state.respectCooldowns and isAbilityOnCooldown(key) then
					return
				end
			end
		end
		-- 3. Check cooldown before fresh dispatch
		if state.respectCooldowns and isAbilityOnCooldown(key) then
			return
		end
		if now < KW.nextDispatchAllowedAt then return end
		KW.dispatchedHeldKeys[key] = now
		KW.lastDispatchedKey = key
		KW.lastDispatchedAt = now
		KW.lastOwnAbilityCastAt = now
		KW.installControllerHooks()
		local btn = getHudButtonForKey(key)
		if isMobileOnly then
			if not KW.mobileCanRunHooked and type(AbilityController.CanRunAbilities) == "function" then
				KW.mobileCanRunHooked = true
				local origCanRun = AbilityController.CanRunAbilities
				AbilityController.CanRunAbilities = function(self, abMod, keyName, ...)
					local ok, cur = origCanRun(self, abMod, keyName, ...)
					if not ok and KW.mobileSpamBypassRagdoll then
						local char = LocalPlayer.Character
						local hum = char and char:FindFirstChildOfClass("Humanoid")
						local rag = char and char:GetAttribute("Ragdoll")
						if hum and hum.Health > 0 and rag and rag > 0 then
							if not (state.respectCooldowns and isAbilityOnCooldown(keyName)) then
								return true, cur
							end
						end
					end
					return ok, cur
				end
			end
			local safeBtn = (btn and btn:FindFirstChild("Cooldown")) and btn or nil
			local function runMobileDispatch(fn, bArg)
				KW.mobileSpamBypassRagdoll = (KW.heldHudButtons[key] == true)
				pcall(fn, bArg, key)
