							KW.ek5Role = "victim"
							KW.ek5VictimActive = true
							KW.ek5VictimArrived = false
							KW.ek5StartedAt = os.clock()
							KW.markIntentionalTp(6.5)
						end
					elseif ev == "Arrive" or ev == "SoulGui" then
						if (KW.ek5CasterActiveUntil or 0) < os.clock() and KW.ek5Role ~= "caster" then
