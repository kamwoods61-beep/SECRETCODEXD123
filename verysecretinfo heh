local detect = { telekinesis = false, shield = false }
local TK_ACTIVE_WELDS = { "GrabWeld", "ChokeWeld", "VictimWeld", "TKWeld" }
local TK_ACTIVE_EFFECTS = { "Telekinesis", "Holding", "Choke" }
local function computeTelekinesis()
	local c = LocalPlayer.Character
	if not c then return false end
	local hum = c:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if animator then
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			local tn = track.Name:lower()
			if track.IsPlaying and (tn:find("telekinesis") or tn:find("choke") or tn:find("grab") or tn:find("holding")) then
				return true
			end
		end
	end
	if AbilityController then
		if (AbilityController.CurrentAbility == "Telekinesis" and AbilityController.Holding == true) then
			return true
		end
		local abMod = AbilityController.AbilityModule
		local cur = AbilityController.CurrentAbility
		if cur and abMod and abMod.AbilityFunctions and abMod.AbilityFunctions[cur] then
			local animTrack = AnimationController and AnimationController.GetAnimationTrack and AnimationController:GetAnimationTrack("Telekinesis")
			if animTrack and animTrack.IsPlaying then
				return true
			end
		end
	end
	if c:GetAttribute("Grabbing") == true or c:GetAttribute("HoldingTarget") == true or c:GetAttribute("Choking") == true then
		return true
	end
	for _, n in ipairs(TK_ACTIVE_WELDS) do
		if c:FindFirstChild(n) then return true end
	end
	local ci = c:FindFirstChild("CharacterInfo")
	local eff = ci and ci:FindFirstChild("Effects")
	if eff then
		for _, n in ipairs(TK_ACTIVE_EFFECTS) do
			if eff:FindFirstChild(n) then return true end
		end
	end
	return false
end
local function computeShield()
	local c = LocalPlayer.Character
	if not c then return false end
	if UserInputService:IsKeyDown(Enum.KeyCode.Q) then return true end
