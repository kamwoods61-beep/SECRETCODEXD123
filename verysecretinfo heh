local function countTool(name)
	local n = 0
	for _, t in ipairs(LocalPlayer.Backpack:GetChildren()) do
		if t.Name == name then n += 1 end
	end
	if LocalPlayer.Character then
		for _, t in ipairs(LocalPlayer.Character:GetChildren()) do
			if t:IsA("Tool") and t.Name == name then n += 1 end
		end
	end
	return n
end
local function findGroundHerb(targetName)
	local locs = workspace:FindFirstChild("Locations")
	local ingFolder = locs and (locs:FindFirstChild("Ingriedients") or locs:FindFirstChild("Ingredients"))
	if not ingFolder then return nil, nil end
	local myHrp = getHRP(LocalPlayer.Character)
	local bestPart, bestPrompt, bestDist = nil, nil, math.huge
	for _, item in ipairs(ingFolder:GetChildren()) do
		if item.Name == targetName then
			-- Skip any plant that is not fully grown or cannot be picked up
			local grownVal = item:FindFirstChild("Grown")
			local canPickVal = item:FindFirstChild("CanPickUp")
			if grownVal and grownVal:IsA("BoolValue") and not grownVal.Value then continue end
			if canPickVal and canPickVal:IsA("BoolValue") and not canPickVal.Value then continue end
			local prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true)
			if prompt and prompt.Enabled then
				local part = item:IsA("BasePart") and item or (prompt.Parent and prompt.Parent:IsA("BasePart") and prompt.Parent) or item:FindFirstChildWhichIsA("BasePart", true)
				if part then
					local d = myHrp and (part.Position - myHrp.Position).Magnitude or 0
					if d < bestDist then
						bestDist = d
						bestPart = part
						bestPrompt = prompt
					end
				end
			end
		end
	end
	return bestPart, bestPrompt
end
