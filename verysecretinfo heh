local function tryOutspamStep()
	if not state.equippedSpammer or UserInputService:GetFocusedTextBox() then return end
	local c = LocalPlayer.Character
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	if not c or not hum or hum.Health <= 0 then return end
	local abName = getEquippedAbilityName()
	if not abName or abName == "Levitation" or abName == "Channel Magic" then return end
	local now = os.clock()
	local cds = c:FindFirstChild("Cooldowns")
	if cds and cds:FindFirstChild(abName) then
		lastCastAck[abName] = nil
		return
	end
	local cfg = AbilityConfig and AbilityConfig[abName]
	if hasAbilityType(cfg, "Hold") then return end
	if type(cfg) == "table" and tonumber(cfg.MagicRequirement) and cfg.MagicRequirement > 0 then
		local cv = c:FindFirstChild("CharacterValues")
		local mVal = cv and cv:FindFirstChild("Magic")
		if mVal and mVal:IsA("NumberValue") and mVal.Value < cfg.MagicRequirement then
			return
		end
	end
	local rag = c:FindFirstChild("Ragdoll")
	if rag and rag:IsA("BoolValue") and rag.Value then
		table.clear(lastCastAck)
		return
	end
	local minInterval = 1 / 29
	if hasAbilityType(cfg, "PrepClick") and minInterval < 0.15 then minInterval = 0.15 end
	if hasAbilityType(cfg, "Toggle") and minInterval < 0.35 then minInterval = 0.35 end
	if lastCastAck[abName] and (now - lastCastAck[abName]) < minInterval then
		return
	end
	local effRange = state.spamRange
	local target = state.silentAim and getNearestTarget(effRange) or nil
	local isCombo = type(cfg) == "table" and type(cfg.ComboSteps) == "table"
	local stNow = workspace:GetServerTimeNow()
	local inCombo = c:GetAttribute("InComboUntil")
	local cueEnds = c:GetAttribute("ComboCueEnds")
	local isComboActive = isCombo and ((type(inCombo) == "number" and inCombo > stNow) or (type(cueEnds) == "number" and cueEnds > stNow))
	if hasAbilityType(cfg, "Target") and not hasAbilityType(cfg, "Self") and not target and not isComboActive then
		return
	end
	if isCombo then
		local mv = c:GetAttribute("MoveIndex") or 0
		if isComboActive and lastComboStep[abName] == mv and lastCastAck[abName] and (now - lastCastAck[abName]) < 0.25 then
			return
		end
		lastComboStep[abName] = mv
	end
	lastCastAck[abName] = now
	fireEquippedAbility(abName, target)
end
