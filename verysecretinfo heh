task.spawn(function()
	local VIM = pcall(function() return game:GetService("VirtualInputManager") end) and game:GetService("VirtualInputManager") or nil
	local GuiSvc = game:GetService("GuiService")
	local lastClickedHair = setmetatable({}, { __mode = "k" })
	local function clickHairBtn(btn)
		local fakeMouse = { UserInputType = Enum.UserInputType.MouseButton1, UserInputState = Enum.UserInputState.Begin }
		local fakeTouch = { UserInputType = Enum.UserInputType.Touch, UserInputState = Enum.UserInputState.Begin }
		if type(getconnections) == "function" then
			for _, sig in ipairs({ btn.MouseButton1Click, btn.Activated, btn.MouseButton1Down, btn.InputBegan }) do
				local ok, conns = pcall(getconnections, sig)
				if ok and type(conns) == "table" then
					for _, conn in ipairs(conns) do
						pcall(function()
							if sig == btn.InputBegan then
								if type(conn.Function) == "function" then conn.Function(fakeMouse); conn.Function(fakeTouch)
								elseif conn.Fire then conn:Fire(fakeMouse); conn:Fire(fakeTouch) end
							else
								if type(conn.Function) == "function" then conn.Function()
								elseif conn.Fire then conn:Fire() end
							end
						end)
					end
				end
			end
		end
		if type(firesignal) == "function" then
			pcall(firesignal, btn.MouseButton1Click)
			pcall(firesignal, btn.Activated)
			pcall(firesignal, btn.InputBegan, fakeMouse)
			pcall(firesignal, btn.InputBegan, fakeTouch)
		end
		if VIM and btn.AbsoluteSize.X > 0 and btn.AbsoluteSize.Y > 0 then
			pcall(function()
				local inset = GuiSvc:GetGuiInset()
				local cx = btn.AbsolutePosition.X + btn.AbsoluteSize.X * 0.5 + inset.X
				local cy = btn.AbsolutePosition.Y + btn.AbsoluteSize.Y * 0.5 + inset.Y
				VIM:SendMouseMoveEvent(cx, cy, game)
				task.wait(0.025)
				VIM:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
				task.wait(0.04)
				VIM:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
			end)
		end
	end
	local lastClearFire = 0
	while not _G.KayWareEOWStopped do
		task.wait(0.1)
		if state.autoEscapeBadHair then
			local pg = LocalPlayer:FindFirstChild("PlayerGui")
			local fraz = pg and pg:FindFirstChild("FrazzledFX")
			local c = LocalPlayer.Character
			local hasNoCast = c and c:GetAttribute("NoCast_BadHairDay")
			local clickedAny = false
			local remaining = 0
			if fraz then
				local now = os.clock()
				for _, child in ipairs(fraz:GetDescendants()) do
					if not state.autoEscapeBadHair or _G.KayWareEOWStopped then break end
					if child:IsA("GuiButton") and child.Visible and child.Active and (child.Name == "HairLock" or child.Name:lower():find("hair")) then
						remaining += 1
						if not lastClickedHair[child] or (now - lastClickedHair[child]) >= 0.35 then
							lastClickedHair[child] = now
							clickedAny = true
							clickHairBtn(child)
							task.wait(0.12)
						end
					end
				end
			end
			-- Once all hairs are gone (or stuck with NoCast_BadHairDay and no hairs left), tell server it's cleared
			if (hasNoCast or fraz) and remaining == 0 and (os.clock() - lastClearFire) >= 0.5 then
				lastClearFire = os.clock()
				local rs = game:GetService("ReplicatedStorage")
				local ev = rs:FindFirstChild("Events_.")
				local bh = ev and ev:FindFirstChild("BadHairFX")
				if bh then pcall(function() bh:FireServer("Cleared") end) end
				if c and c:GetAttribute("NoCast_BadHairDay") then
					pcall(function() c:SetAttribute("NoCast_BadHairDay", nil) end)
				end
			elseif clickedAny and (os.clock() - lastClearFire) >= 0.7 then
				-- Recheck if all hairs disappeared right after clicking
				local left = 0
				if fraz and fraz.Parent then
					for _, child in ipairs(fraz:GetDescendants()) do
						if child:IsA("GuiButton") and child.Visible and child.Active and (child.Name == "HairLock" or child.Name:lower():find("hair")) then
							left += 1
						end
					end
				end
				if left == 0 then
					lastClearFire = os.clock()
					local rs = game:GetService("ReplicatedStorage")
					local ev = rs:FindFirstChild("Events_.")
					local bh = ev and ev:FindFirstChild("BadHairFX")
					if bh then pcall(function() bh:FireServer("Cleared") end) end
				end
			end
		end
	end
end)
