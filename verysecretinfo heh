		local vLbl = kwText(wrap, { Size = UDim2.fromOffset(50, 16), Position = UDim2.new(1, -60, 0, 4), Font = Enum.Font.Code, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = KW_T.Cyan, Text = tostring(cur) })
		local bar = kwNew("TextButton", { Size = UDim2.new(1, -20, 0, 6), Position = UDim2.fromOffset(10, 25), BackgroundColor3 = KW_T.Control, Text = "", AutoButtonColor = false }, wrap)
		kwRound(bar, 3)
		local fill = kwNew("Frame", { Size = UDim2.new((cur - minV) / math.max(1, maxV - minV), 0, 1, 0), BackgroundColor3 = KW_T.Accent, BorderSizePixel = 0 }, bar)
		kwRound(fill, 3)
		local sliding = false
		local function upd(x)
			local rel = math.clamp((x - bar.AbsolutePosition.X) / math.max(1, bar.AbsoluteSize.X), 0, 1)
			local st = step or 1
			local v = math.clamp(math.floor((minV + (maxV - minV) * rel) / st + 0.5) * st, minV, maxV)
			fill.Size = UDim2.new((v - minV) / math.max(1, maxV - minV), 0, 1, 0)
			vLbl.Text = tostring(v)
			if cb then pcall(cb, v) end
		end
		bar.InputBegan:Connect(function(inp) if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then sliding = true; upd(inp.Position.X) end end)
		trackConn(UserInputService.InputChanged:Connect(function(inp) if sliding and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then upd(inp.Position.X) end end))
		trackConn(UserInputService.InputEnded:Connect(function(inp) if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then sliding = false end end))
