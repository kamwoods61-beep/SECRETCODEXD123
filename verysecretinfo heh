local function ensureTotemPlatform()
	local c = LocalPlayer.Character
	local hrp = c and c:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local map = workspace:FindFirstChild("Map")
	local existing = (map and map:FindFirstChild("KW_TotemPlatform")) or workspace:FindFirstChild("KW_TotemPlatform")
	if existing then existing:Destroy() end
	-- Only spawn a raycast ground pad when actually airborne (no real ground within 5 studs below)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = { c }
	if workspace:Raycast(hrp.Position, Vector3.new(0, -5, 0), rp) then
		return
	end
	local plat = Instance.new("Part")
	plat.Name = "KW_TotemPlatform"
	plat.Size = Vector3.new(14, 1, 14)
	-- Keep top surface safely below feet so it never lifts/levitates the character
	plat.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y - 4.0, hrp.Position.Z)
	plat.Anchored = true
	plat.CanCollide = true
	plat.Transparency = 1
	plat.Material = Enum.Material.Plastic
	-- Place inside workspace.Map so map-filtered raycasts treat it as valid ground
	plat.Parent = map or workspace
	task.delay(0.6, function()
		if plat and plat.Parent then
			plat:Destroy()
		end
	end)
end
function KW.installControllerHooks()
	if not isNewFender then return end
	if AbilityController then
		local curPress = AbilityController._pressExtra
		if type(curPress) == "function" and not KW.kwWrappedFuncs[curPress] then
			local rawPress = curPress
			KW.hookedOriginals.pressExtraFn = rawPress
			local wrappedPress = function(btn, key, ...)
				KW.lastOwnAbilityAt = os.clock()
				if key == "X" then KW.lastOwnSummonCastAt = os.clock() end
				if not btn and type(key) == "string" then btn = getHudButtonForKey(key) end
				if key == "ExtraKey4" or (btn and btn.Name == "ExtraKey4") then
					pcall(ensureTotemPlatform)
				end
				if key == "ExtraKey5" or (btn and btn.Name == "ExtraKey5") then
					KW.ek5Role = "caster"
					KW.ek5CasterActiveUntil = os.clock() + 30.0
				end
				return rawPress(btn, key, ...)
			end
			KW.kwWrappedFuncs[wrappedPress] = true
			AbilityController._pressExtra = wrappedPress
		end
		local curKeyDown = AbilityController._keyDown
		if type(curKeyDown) == "function" and not KW.kwWrappedFuncs[curKeyDown] then
			local rawKeyDown = curKeyDown
			KW.hookedOriginals.keyDownFn = rawKeyDown
			local wrappedKeyDown = function(btn, key, ...)
				KW.lastOwnAbilityAt = os.clock()
				if key == "X" then KW.lastOwnSummonCastAt = os.clock() end
				if not btn and type(key) == "string" then btn = getHudButtonForKey(key) end
				if key == "ExtraKey4" or (btn and btn.Name == "ExtraKey4") then
					pcall(ensureTotemPlatform)
