	end
	if AbilityService and AbilityService.AbilityRequest then
		local req = AbilityService.AbilityRequest
		if type(req) == "table" and type(req.Fire) == "function" and not KW.kwWrappedFuncs[req.Fire] then
			local rawFire = req.Fire
			KW.hookedOriginals.abilityReqOwner = req
			KW.hookedOriginals.abilityReqFire = rawFire
			local wrappedFire = function(self, name, ...)
