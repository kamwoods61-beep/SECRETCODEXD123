	-- Read real hardware cursor in viewport coordinates (matching WorldToScreenPoint / ScreenPointToRay),
	-- never PointerMouse.GetScreenPosition() which returns our own SetOverride target while active.
	local ok, pos, inset = pcall(function()
		return UserInputService:GetMouseLocation(), game:GetService("GuiService"):GetGuiInset()
	end)
	if ok and pos and inset then
		return Vector2.new(pos.X - inset.X, pos.Y - inset.Y)
	end
	local mouse = LocalPlayer and LocalPlayer:GetMouse()
	if mouse then
		return Vector2.new(mouse.X, mouse.Y)
	end
	return UserInputService:GetMouseLocation()
end
KW.getMouseVec = getMouseVec
function KW.raycastModelUnderMouse(cam, mouseVec, myChar, candidateSet)
	if not cam or not mouseVec then return nil, nil end
	local ray = cam:ScreenPointToRay(mouseVec.X, mouseVec.Y)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = { cam }
	if myChar then table.insert(ignore, myChar) end
	for _, folderName in ipairs({"VFX", "Projectiles", "CharactersVFX", "Effects", "Debris"}) do
		local f = workspace:FindFirstChild(folderName)
		if f then table.insert(ignore, f) end
	end
	for _ = 1, 10 do
		rp.FilterDescendantsInstances = ignore
		local res = workspace:Raycast(ray.Origin, ray.Direction * 2500, rp)
		if not res or not res.Instance then break end
		local inst = res.Instance
		local cur = inst
		while cur and cur ~= workspace do
			if candidateSet[cur] then
				return cur, res.Position
			end
			cur = cur.Parent
		end
		-- Continue penetrating non-candidate obstacles (accessories, transparent parts, map props)
		table.insert(ignore, inst)
	end
	return nil, nil
end
function KW.getModelCursorDist(cam, mouseVec, model)
	if not cam or not mouseVec or not model then return math.huge end
	local best = math.huge
	for _, part in ipairs(model:GetChildren()) do
		if part:IsA("BasePart") and part.Transparency < 1 then
			local sp, onScreen = cam:WorldToScreenPoint(part.Position)
			if onScreen and sp.Z > 0.1 then
				local d = (Vector2.new(sp.X, sp.Y) - mouseVec).Magnitude
				if d < best then best = d end
			end
		end
	end
	if best == math.huge then
		local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			local sp, onScreen = cam:WorldToScreenPoint(root.Position)
			if onScreen and sp.Z > 0.1 then
				best = (Vector2.new(sp.X, sp.Y) - mouseVec).Magnitude
			end
		end
	end
	return best
end
local oldGetPlayerNearMouse = nil
if isNewFender and AbilityUtilities and AbilityUtilities.GetPlayerNearMouse then
	oldGetPlayerNearMouse = AbilityUtilities.GetPlayerNearMouse
	AbilityUtilities.GetPlayerNearMouse = function(self, maxDist, arg64)
		if not state.customRangeEnabled then return oldGetPlayerNearMouse(self, maxDist, arg64) end
		local myChar = (self and self.GetActiveCharacter and self:GetActiveCharacter()) or LocalPlayer.Character
		local myPrimary = myChar and myChar.PrimaryPart
		local cam = workspace.CurrentCamera
		if not myPrimary or not cam then return oldGetPlayerNearMouse(self, maxDist, arg64) end
		local excludeFriend = state.excludeFriends and isOutspammerActive
		local numMaxDist = tonumber(maxDist)
		local forced = self and self.ForcedTarget
		if forced ~= nil then
			if typeof(forced) == "Instance" and forced.Parent and forced.PrimaryPart then
				if not (excludeFriend and isFriend(forced)) then
					local limit = (numMaxDist and numMaxDist > 0) and (numMaxDist + 6) or (state.customRangeDistance or 150)
					if (forced.PrimaryPart.Position - myPrimary.Position).Magnitude <= limit then
						self.ForcedUsed = true
						return forced
					end
				end
			end
			return nil
		end
		-- Enforce ability reach; always prioritize the exact player under the user's mouse cursor first
		local effectiveRange = (numMaxDist and numMaxDist > 0) and (numMaxDist + 4) or (state.customRangeDistance or 150)
		local mouseVec = getMouseVec()
		local cursorConePx = math.max(
			85,
			tonumber(LocalPlayer:GetAttribute("OwnerBuffAim")) or 0,
			myChar and tonumber(myChar:GetAttribute("OwnerBuffAim")) or 0
		)
		local validChars = {}
		local validSet = {}
		local nearestWorldChar, nearestWorldDist = nil, math.huge
		local nearestGrabChar, nearestGrabDist = nil, math.huge
		local chars = (self and self.GetCharacters) and self:GetCharacters((not arg64) and LocalPlayer.Character or nil) or {}
		for _, ch in ipairs(chars) do
			if (arg64 or ch ~= myChar) and ch.PrimaryPart
				and not ch:GetAttribute("EmmaAstralBody")
				and not ch:GetAttribute("NoClickTarget")
				and not ch:GetAttribute("FakeDead")
			then
				local isDead = self and self.Died and self:Died(ch)
				if not isDead and not (excludeFriend and isFriend(ch)) then
					local hum = ch:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health > 0 and not ch:GetAttribute("Inmortal") then
						table.insert(validChars, ch)
						validSet[ch] = true
						local worldDist = (ch.PrimaryPart.Position - myPrimary.Position).Magnitude
						if worldDist <= effectiveRange then
							local grabable = (ch:GetAttribute("CantGrab") or 0) <= 0
							if worldDist < nearestWorldDist then
								nearestWorldDist = worldDist
								nearestWorldChar = ch
							end
							if grabable and worldDist < nearestGrabDist then
								nearestGrabDist = worldDist
								nearestGrabChar = ch
							end
						end
					end
				end
			end
		end
		-- Mobile / Touch mode: always target closest player in 3D world range on tap/click!
		local isTouchDevice = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
		if isTouchDevice then
			local autoChosen = nearestGrabChar or nearestWorldChar
			if autoChosen and autoChosen.PrimaryPart and (autoChosen.PrimaryPart.Position - myPrimary.Position).Magnitude <= effectiveRange then
				return autoChosen
			end
			for _, ch in ipairs(validChars) do
				if ch.PrimaryPart and (ch.PrimaryPart.Position - myPrimary.Position).Magnitude <= effectiveRange then
					return ch
				end
			end
			return nil
		end
		-- Step 1 (PC): Direct cursor raycast hit guarantees hovering over a player selects THAT player, not someone else
		local rayChar = KW.raycastModelUnderMouse(cam, mouseVec, myChar, validSet)
		if rayChar and rayChar.PrimaryPart then
			local rayWorldDist = (rayChar.PrimaryPart.Position - myPrimary.Position).Magnitude
			if rayWorldDist <= effectiveRange then
				return rayChar
			end
			-- User is directly hovering an out-of-range player manually: do not snap onto a different bystander
			if not isOutspammerActive then
				return nil
			end
		end
		-- Step 2 (PC): Screen-space nearest to cursor within tight cone (check torso/head/root so limbs near cursor register accurately)
		if not state.nearestTargetMode or not isOutspammerActive then
			local bestChar, bestScreenDist = nil, math.huge
			for _, ch in ipairs(validChars) do
				local worldDist = (ch.PrimaryPart.Position - myPrimary.Position).Magnitude
				if worldDist <= effectiveRange then
					local sDist = KW.getModelCursorDist(cam, mouseVec, ch)
					if sDist <= cursorConePx and sDist < bestScreenDist then
						bestScreenDist = sDist
						bestChar = ch
					end
				end
			end
			if bestChar then
				return bestChar
			end
		end
		-- Only allow non-cursor nearest-in-world fallback when Outspammer/nearestTargetMode auto-targeting is active
		if isOutspammerActive or state.nearestTargetMode then
			local autoChosen = nearestGrabChar or nearestWorldChar
			if autoChosen and autoChosen.PrimaryPart and (autoChosen.PrimaryPart.Position - myPrimary.Position).Magnitude <= effectiveRange then
				return autoChosen
			end
		end
		-- Never fall back to native PointerMouse (which may carry an override or wider stale pos)
		return nil
	end
end
local oldGetObjectNearMouse = nil
if isNewFender and AbilityUtilities and AbilityUtilities.GetObjectNearMouse then
	oldGetObjectNearMouse = AbilityUtilities.GetObjectNearMouse
	AbilityUtilities.GetObjectNearMouse = function(self, maxDist)
		if not state.customRangeEnabled then return oldGetObjectNearMouse(self, maxDist) end
		local myChar = (self and self.GetActiveCharacter and self:GetActiveCharacter()) or LocalPlayer.Character
		local myPrimary = myChar and myChar.PrimaryPart
		local cam = workspace.CurrentCamera
		if not myPrimary or not cam then return oldGetObjectNearMouse(self, maxDist) end
		local excludeFriend = state.excludeFriends and isOutspammerActive
		local mouseVec = getMouseVec()
		local cursorConePx = math.max(
			90,
			tonumber(LocalPlayer:GetAttribute("OwnerBuffAim")) or 0,
			myChar and tonumber(myChar:GetAttribute("OwnerBuffAim")) or 0
		)
		local numMaxDist = tonumber(maxDist)
		local maxWorldDist = (numMaxDist and numMaxDist > 0) and (numMaxDist + 4) or (state.customRangeDistance or 200)
		local list = {}
		local validSet = {}
		local nearestWorldObj, nearestWorldDist = nil, math.huge
		local nearestGrabObj, nearestGrabDist = nil, math.huge
		local chars = (self and self.GetCharacters) and self:GetCharacters(LocalPlayer.Character) or {}
		for _, ch in ipairs(chars) do
			if ch ~= myChar and ch.PrimaryPart
				and not ch:GetAttribute("EmmaAstralBody")
				and not ch:GetAttribute("NoClickTarget")
				and not ch:GetAttribute("FakeDead")
			then
				local isDead = self and self.Died and self:Died(ch)
				if not isDead and not (excludeFriend and isFriend(ch)) then
					local hum = ch:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health > 0 and not ch:GetAttribute("Inmortal") then
						table.insert(list, ch)
						validSet[ch] = true
						local worldDist = (ch.PrimaryPart.Position - myPrimary.Position).Magnitude
						if worldDist <= maxWorldDist then
							if worldDist < nearestWorldDist then
								nearestWorldDist = worldDist
								nearestWorldObj = ch
							end
							if (ch:GetAttribute("CantGrab") or 0) <= 0 and worldDist < nearestGrabDist then
								nearestGrabDist = worldDist
								nearestGrabObj = ch
							end
						end
					end
				end
			end
		end
		local props = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Props")
		if props then
			local cs = game:GetService("CollectionService")
			for _, p in ipairs(props:GetChildren()) do
				if cs:HasTag(p, "TeleObject") and p.PrimaryPart then
					table.insert(list, p)
					validSet[p] = true
					local worldDist = (p.PrimaryPart.Position - myPrimary.Position).Magnitude
					if worldDist <= maxWorldDist and worldDist < nearestWorldDist then
						nearestWorldDist = worldDist
						nearestWorldObj = p
					end
				end
			end
		end
		local rayObj = KW.raycastModelUnderMouse(cam, mouseVec, myChar, validSet)
		if rayObj and rayObj.PrimaryPart then
			local rayDist = (rayObj.PrimaryPart.Position - myPrimary.Position).Magnitude
			if rayDist <= maxWorldDist then
				if rayObj:IsA("Model") and rayObj:FindFirstChildOfClass("Humanoid") then
					currentLockedChar = rayObj
				end
				return rayObj
			end
			if not isOutspammerActive then
				return nil
			end
		end
		if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
			local autoObj = nearestGrabObj or nearestWorldObj
			if autoObj then
				if autoObj:IsA("Model") and autoObj:FindFirstChildOfClass("Humanoid") then
					currentLockedChar = autoObj
				end
				return autoObj
			end
			return nil
		end
		local bestObj, bestScreenDist = nil, math.huge
		for _, obj in ipairs(list) do
			local part = obj.PrimaryPart
			if part then
				local worldDist = (part.Position - myPrimary.Position).Magnitude
				if worldDist <= maxWorldDist then
					local sDist = KW.getModelCursorDist(cam, mouseVec, obj)
					if sDist < bestScreenDist then
						bestScreenDist = sDist
						bestObj = obj
					end
				end
			end
		end
		if bestObj then
			if not state.nearestTargetMode or bestScreenDist <= 650 then
				if bestObj:IsA("Model") and bestObj:FindFirstChildOfClass("Humanoid") then
					currentLockedChar = bestObj
				end
				return bestObj
			end
		end
		local chosen = bestObj or ((isOutspammerActive or state.nearestTargetMode) and (nearestGrabObj or nearestWorldObj) or nil)
		if chosen then
			if chosen:IsA("Model") and chosen:FindFirstChildOfClass("Humanoid") then
				currentLockedChar = chosen
			end
			return chosen
		end
		-- Never fall through to native oldGetObjectNearMouse (which has no screen cone cap and picks 800px+ off-mouse targets)
		return nil
	end
end
