			-- Pass 2: Substring fallback only if no exact match existed anywhere
			for _, folder in ipairs({ charsSel, morphs, fakeChars }) do
				if folder then
					for _, c in ipairs(folder:GetChildren()) do
						local cClean = c.Name:lower():gsub("[%s%-_%:]", "")
						if cClean:find(targetClean, 1, true) or targetClean:find(cClean, 1, true) then
							return c
						end
					end
