function KW.isVictimTrappedInPendant()
	if not isNewFenderGame then return false end
	local c = LocalPlayer.Character
	if not c then return false end
	-- 0. Absolute exclusion: Davina / Harvest Witch / Harvest Cheerleader uses Soul Bind (her 3rd key)
	-- Davina NEVER uses Freya's pendant trap and can NEVER be teleported to the Red Door!
	local nt = tostring(c:GetAttribute("NameTag") or c:GetAttribute("Name") or c:GetAttribute("DisplayTag") or ""):lower()
	if nt:find("harvest", 1, true) or nt:find("davina", 1, true) then
		return false
	end
	-- 1. Never victim if local player is the caster or recently cast Freya ExtraKey5
	if KW.ek5Role == "caster" or (KW.ek5CasterActiveUntil and os.clock() < KW.ek5CasterActiveUntil) then
		return false
	end
	if (KW.ek5EndedAt or 0) > (KW.ek5StartedAt or 0) and (os.clock() - KW.ek5EndedAt) < 2.0 then
		return false
	end
	-- 2. Physical location check: ONLY consider trapped if character is physically inside PendantTrap dimension!
	local hrp = c:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	local ws = game:GetService("Workspace")
	local map = ws:FindFirstChild("Map")
	local dim = map and map:FindFirstChild("Dimension")
	local pt = dim and dim:FindFirstChild("PendantTrap")
	local ptPos = (pt and pt:GetPivot().Position) or Vector3.new(1081.49, 120.57, -1089.62)
	-- If character is further than 180 studs from PendantTrap center, they CANNOT be inside the pendant!
	if (hrp.Position - ptPos).Magnitude > 180 then
		KW.manualPendantVisit = false
		return false
	end
	-- 3. Inside PendantTrap, verify victim markers (never generic SoulGui alone)
	if _G.BonnieExtraKey5VictimActive == true then
		KW.manualPendantVisit = false
		return true
	end
	local pgui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if pgui and (pgui:FindFirstChild("LostSisterEK5Movie") or pgui:FindFirstChild("BonnieExtraKey5White")) then
		KW.manualPendantVisit = false
		return true
	end
	if KW.ek5Role == "victim" and (KW.ek5VictimArrived or KW.ek5VictimActive) then
		KW.manualPendantVisit = false
		return true
	end
	-- If user manually teleported to Pendant to visit/farm, do not register as trapped unless victim markers fire
	if KW.manualPendantVisit then
		return false
	end
	-- 4. If physically inside PendantTrap and not caster, any proximity prompt on RedDoor confirms victim state
	local redDoor = (pt and pt:FindFirstChild("Doors") and pt.Doors:FindFirstChild("RedDoor"))
		or (pt and pt:FindFirstChild("RedDoor", true))
		or ws:FindFirstChild("RedDoor", true)
	if redDoor and redDoor:FindFirstChildWhichIsA("ProximityPrompt", true) then
		return true
	end
	return false
end
