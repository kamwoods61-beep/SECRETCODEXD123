local function getEquippedAbilityName(c)
	local ae = c:FindFirstChild("AbilityEquipped")
	if ae and ae:IsA("StringValue") and ae.Value ~= "" then return ae.Value end
	local attr = c:GetAttribute("EquippedAbility")
	if type(attr) == "string" and attr ~= "" then return attr end
	local cs = c:FindFirstChild("CastingSpells")
	if cs then
		for _, v in ipairs(cs:GetChildren()) do
			if v:IsA("BoolValue") and v.Value == true then return v.Name end
		end
	end
	return ""
end
