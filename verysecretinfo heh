local savedAmbient = Lighting.Ambient
local savedOutdoorAmbient = Lighting.OutdoorAmbient
local savedBrightness = Lighting.Brightness
local savedGlobalShadows = Lighting.GlobalShadows
local savedExposure = Lighting.ExposureCompensation
local savedFogStart = Lighting.FogStart
local savedFogEnd = Lighting.FogEnd
local function applyFullbright(on)
	if on then
		Lighting.Ambient = Color3.fromRGB(185, 185, 185)
		Lighting.OutdoorAmbient = Color3.fromRGB(185, 185, 185)
		Lighting.Brightness = 3
		Lighting.GlobalShadows = false
		Lighting.ExposureCompensation = 0.35
	else
		Lighting.Ambient = savedAmbient
		Lighting.OutdoorAmbient = savedOutdoorAmbient
		Lighting.Brightness = savedBrightness
		Lighting.GlobalShadows = savedGlobalShadows
		Lighting.ExposureCompensation = savedExposure
	end
end
local function applyNoFog(on)
	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	if on then
		Lighting.FogStart = 1e6
		Lighting.FogEnd = 1e6
		if atm then atm.Density = 0; atm.Haze = 0 end
	else
		Lighting.FogStart = savedFogStart
		Lighting.FogEnd = savedFogEnd
		if atm then atm.Density = 0.3; atm.Haze = 0 end
	end
end
trackConn(RunService.RenderStepped:Connect(function()
	if state.lockTime then
		Lighting.ClockTime = state.lockTimeHour
	end
	if state.fullbright then
		Lighting.Ambient = Color3.fromRGB(185, 185, 185)
		Lighting.OutdoorAmbient = Color3.fromRGB(185, 185, 185)
		Lighting.Brightness = 3
		Lighting.GlobalShadows = false
	end
	if state.noFog then
		Lighting.FogStart = 1e6
		Lighting.FogEnd = 1e6
		local atm = Lighting:FindFirstChildOfClass("Atmosphere")
		if atm then atm.Density = 0; atm.Haze = 0 end
	end
end))
local function applyAntiLag(on)
	for _, eff in ipairs(Lighting:GetChildren()) do
		if eff:IsA("BlurEffect") or eff:IsA("BloomEffect") or eff:IsA("SunRaysEffect") then
			eff.Enabled = not on
		end
	end
	for _, fname in ipairs({ "FireAreas", "PyroScorchFX", "GroundDebris" }) do
		local f = workspace:FindFirstChild(fname)
		if f then
			for _, d in ipairs(f:GetDescendants()) do
				if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") then
					d.Enabled = not on
				end
			end
		end
	end
end
